{
  "expo": {
    "name": "Laundri",
    "slug": "laundry-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/appstore.png",
    "splash": {
      "image": "./assets/icons/splash-icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#36768a"
    },
    "scheme": "laundryapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autolaundry.app",
      "icon": "./assets/icons/appstore.png",
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "icon": "./assets/icons/playstore.png",
      "package": "com.autolaundry.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E1C2E",
        "foregroundImage": "./assets/icons/playstore.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Laundri to use Face ID for secure sign-in."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon.jpg",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#36768a",
          "dark": {
            "backgroundColor": "#36768a"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
