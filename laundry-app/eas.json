{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.19.0",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "node": "24.19.0",
      "distribution": "internal"
    },
    "production": {
      "node": "24.19.0",
      "autoIncrement": true,
      "android": {
        "credentialsSource": "local"
      },
      "ios": {
        "distribution": "store",
        "credentialsSource": "remote"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "credentials/android/play-service-account.json",
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6789571411"
      }
    }
  }
}
