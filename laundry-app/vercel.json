{
  "buildCommand": "npm run export:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/l/:id",
      "destination": "/launderer-link.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
